<view class="search-bar {{showSearchBtn ? 'search-bar--home' : ''}}">
  <view class="search-input-wrap">
    <view class="search-icon"></view>
    <input
      class="search-input"
      type="text"
      placeholder="{{placeholder}}"
      value="{{value}}"
      confirm-type="search"
      bindinput="onInput"
      bindconfirm="onConfirm"
      bindfocus="onFocus"
    />
    <view class="search-camera" wx:if="{{showCamera}}" bindtap="onCamera">
      <view class="camera-icon"></view>
    </view>
    <view class="search-clear" wx:if="{{value}}" bindtap="onClear">×</view>
  </view>
  <view class="search-btn" wx:if="{{showSearchBtn}}" bindtap="onSearchTap">搜索</view>
  <view class="search-filter" wx:if="{{showFilter}}" bindtap="onFilter">筛选</view>
</view>
