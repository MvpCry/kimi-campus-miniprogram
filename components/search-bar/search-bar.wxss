.search-bar {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  background: #FFFFFF;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-muted);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  height: 72rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #94A3B8;
  border-radius: 50%;
  margin-right: var(--space-sm);
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 4rpx;
  background: #94A3B8;
  bottom: -8rpx;
  right: -6rpx;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
  background: transparent;
}

.search-input::placeholder {
  color: #94A3B8;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #CBD5E1;
  color: #FFFFFF;
  font-size: 24rpx;
  margin-left: var(--space-sm);
  flex-shrink: 0;
}

.search-filter {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 0 var(--space-sm);
}
