.search-bar {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  background: #FFFFFF;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-muted);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
  height: 72rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #94A3B8;
  border-radius: 50%;
  margin-right: var(--space-sm);
  position: relative;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 4rpx;
  background: #94A3B8;
  bottom: -8rpx;
  right: -6rpx;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
  background: transparent;
}

.search-input::placeholder {
  color: #94A3B8;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #CBD5E1;
  color: #FFFFFF;
  font-size: 24rpx;
  margin-left: var(--space-sm);
  flex-shrink: 0;
}

.search-camera {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: var(--space-sm);
  flex-shrink: 0;
}

.camera-icon {
  width: 36rpx;
  height: 28rpx;
  border: 4rpx solid #64748B;
  border-radius: 4rpx;
  position: relative;
}

.camera-icon::before {
  content: '';
  position: absolute;
  top: -10rpx;
  left: 6rpx;
  width: 16rpx;
  height: 6rpx;
  background: #64748B;
  border-radius: 2rpx 2rpx 0 0;
}

.camera-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #64748B;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.search-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  background: var(--color-destructive);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
}

.search-btn:active {
  opacity: 0.9;
}

.search-filter {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
  padding: 0 var(--space-sm);
}
