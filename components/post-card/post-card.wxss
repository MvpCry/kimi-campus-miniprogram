.post-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  transition: transform 150ms ease;
}

.post-card:active {
  transform: scale(0.99);
}

.post-main {
  display: flex;
  align-items: stretch;
  gap: var(--space-md);
}

.post-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.post-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.type-tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: rgba(124, 58, 237, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.post-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.post-category,
.post-condition,
.post-campus {
  font-size: 22rpx;
  color: #64748B;
  background: var(--color-muted);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: var(--space-sm);
}

.post-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.post-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.post-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-destructive);
}

.post-time {
  font-size: 22rpx;
  color: #94A3B8;
}

.post-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-sm);
  background: var(--color-muted);
  flex-shrink: 0;
}

.empty-image {
  background: linear-gradient(135deg, #ECEEF9 0%, #DDD6FE 100%);
}
