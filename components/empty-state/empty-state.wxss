.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-3xl) var(--space-lg);
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--color-muted);
  margin-bottom: var(--space-lg);
  position: relative;
}

.empty-icon::before,
.empty-icon::after {
  content: '';
  position: absolute;
  background: var(--color-border);
  border-radius: 8rpx;
}

.empty-icon--search::before {
  width: 64rpx;
  height: 64rpx;
  top: 44rpx;
  left: 40rpx;
  border: 8rpx solid var(--color-border);
  background: transparent;
  border-radius: 50%;
}

.empty-icon--search::after {
  width: 28rpx;
  height: 8rpx;
  top: 96rpx;
  left: 92rpx;
  transform: rotate(45deg);
  border-radius: 4rpx;
}

.empty-icon--heart::before {
  width: 64rpx;
  height: 56rpx;
  top: 50rpx;
  left: 48rpx;
  background: var(--color-border);
  clip-path: polygon(50% 100%, 0 35%, 25% 0, 50% 20%, 75% 0, 100% 35%);
}

.empty-icon--heart::after {
  display: none;
}

.empty-icon--clock::before {
  width: 72rpx;
  height: 72rpx;
  top: 40rpx;
  left: 40rpx;
  border: 8rpx solid var(--color-border);
  background: transparent;
  border-radius: 50%;
}

.empty-icon--clock::after {
  width: 28rpx;
  height: 8rpx;
  top: 72rpx;
  left: 76rpx;
  background: var(--color-border);
  transform: rotate(90deg);
}

.empty-icon--message::before {
  width: 80rpx;
  height: 56rpx;
  top: 48rpx;
  left: 40rpx;
  background: var(--color-border);
  border-radius: 12rpx;
}

.empty-icon--message::after {
  width: 0;
  height: 0;
  top: 96rpx;
  left: 60rpx;
  background: transparent;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 20rpx solid var(--color-border);
}

.empty-icon--lock::before {
  width: 56rpx;
  height: 44rpx;
  top: 72rpx;
  left: 52rpx;
  background: var(--color-border);
  border-radius: 8rpx;
}

.empty-icon--lock::after {
  width: 36rpx;
  height: 28rpx;
  top: 40rpx;
  left: 62rpx;
  background: transparent;
  border: 8rpx solid var(--color-border);
  border-radius: 18rpx 18rpx 0 0;
}

.empty-icon--chart::before,
.empty-icon--chart::after {
  width: 24rpx;
  bottom: 44rpx;
  top: auto;
  background: var(--color-border);
}

.empty-icon--chart::before {
  left: 48rpx;
  height: 48rpx;
}

.empty-icon--chart::after {
  left: 88rpx;
  height: 72rpx;
}

.empty-icon--filter::before {
  width: 0;
  height: 0;
  top: 44rpx;
  left: 60rpx;
  background: transparent;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 28rpx solid var(--color-border);
}

.empty-icon--filter::after {
  width: 8rpx;
  height: 40rpx;
  top: 72rpx;
  left: 76rpx;
  background: var(--color-border);
}

.empty-icon--check::before {
  width: 28rpx;
  height: 10rpx;
  top: 78rpx;
  left: 48rpx;
  background: var(--color-border);
  transform: rotate(45deg);
}

.empty-icon--check::after {
  width: 48rpx;
  height: 10rpx;
  top: 66rpx;
  left: 62rpx;
  background: var(--color-border);
  transform: rotate(-45deg);
}

.empty-icon--box::before {
  width: 80rpx;
  height: 12rpx;
  top: 60rpx;
  left: 40rpx;
}

.empty-icon--box::after {
  width: 50rpx;
  height: 12rpx;
  top: 88rpx;
  left: 55rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: var(--space-sm);
}

.empty-desc {
  font-size: 26rpx;
  color: #94A3B8;
  margin-bottom: var(--space-lg);
  line-height: 1.5;
}

.empty-action {
  min-width: 200rpx;
}
