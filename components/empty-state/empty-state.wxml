<view class="empty-state">
  <view class="empty-icon empty-icon--{{icon}}"></view>
  <text class="empty-title">{{title}}</text>
  <text class="empty-desc" wx:if="{{description}}">{{description}}</text>
  <view class="empty-action btn btn-secondary btn-sm" wx:if="{{actionText}}" bindtap="onAction">
    {{actionText}}
  </view>
</view>
