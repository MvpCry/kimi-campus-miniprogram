<view class="product-card" bindtap="onTap">
  <view class="product-image-wrap">
    <image
      wx:if="{{post.images && post.images.length > 0}}"
      class="product-image"
      src="{{post.images[0]}}"
      mode="aspectFill"
      lazy-load
    />
    <view wx:else class="product-image product-image--empty"></view>
    <view class="product-tag" wx:if="{{post.tags && post.tags.length > 0}}">{{post.tags[0]}}</view>
  </view>

  <view class="product-info">
    <text class="product-title">{{post.title}}</text>
    <view class="product-meta">
      <text class="product-price" wx:if="{{priceText}}">{{priceText}}</text>
      <text class="product-views" wx:if="{{viewText}}">{{viewText}}</text>
    </view>
    <view class="product-campus" wx:if="{{post.campus}}">
      <text class="campus-dot"></text>
      <text>{{post.campus}}</text>
    </view>
  </view>
</view>
