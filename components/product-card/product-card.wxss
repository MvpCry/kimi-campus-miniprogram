.product-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform 150ms ease;
}

.product-card:active {
  transform: scale(0.98);
}

.product-image-wrap {
  position: relative;
  width: 100%;
  padding-top: 100%;
  background: var(--color-muted);
}

.product-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}

.product-image--empty {
  background: linear-gradient(135deg, #ECEEF9 0%, #DDD6FE 100%);
}

.product-tag {
  position: absolute;
  left: var(--space-sm);
  bottom: var(--space-sm);
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.product-info {
  padding: var(--space-md);
}

.product-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: var(--space-sm);
}

.product-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-sm);
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-destructive);
}

.product-views {
  font-size: 20rpx;
  color: #94A3B8;
  flex-shrink: 0;
}

.product-campus {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
  font-size: 20rpx;
  color: #64748B;
}

.campus-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-accent);
}
