.category-nav {
  width: 100%;
  background: var(--color-background);
}

.category-scroll {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  padding: var(--space-sm) 0;
}

.category-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  transition: all 150ms ease;
}

/* Pill theme */
.category-nav--pill .category-item {
  height: 64rpx;
  padding: 0 var(--space-md);
  margin-right: var(--space-sm);
  border-radius: 32rpx;
  background: var(--color-muted);
  color: #64748B;
  font-size: 26rpx;
}

.category-nav--pill .category-item:first-child {
  margin-left: var(--space-md);
}

.category-nav--pill .category-item:last-child {
  margin-right: var(--space-md);
}

.category-nav--pill .category-item.is-active {
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-weight: 600;
}

.category-nav--pill .category-item:active {
  opacity: 0.85;
}

/* Card theme */
.category-nav--card .category-scroll {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: var(--space-md);
  gap: var(--space-md);
}

.category-nav--card .category-item {
  flex-direction: column;
  width: calc(25% - var(--space-md));
  padding: var(--space-md) 0;
  border-radius: var(--radius-md);
  background: var(--color-muted);
}

.category-nav--card .category-item.is-active {
  background: rgba(124, 58, 237, 0.12);
}

.category-nav--card .category-item:active {
  transform: scale(0.95);
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(124, 58, 237, 0.1);
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: var(--space-sm);
}

.category-nav--card .category-name {
  font-size: 24rpx;
  color: #1F2937;
}

.category-nav--card .is-active .category-name {
  color: var(--color-primary);
  font-weight: 600;
}

/* Grid theme: 横向双列滚动 */
.category-nav--grid {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: var(--space-md) 0;
}

.category-grid-scroll {
  width: 100%;
  white-space: nowrap;
}

.category-grid {
  display: inline-flex;
  flex-direction: row;
  padding: 0 var(--space-md);
}

.category-column {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  width: 140rpx;
  margin-right: var(--space-md);
  flex-shrink: 0;
}

.category-column:last-child {
  margin-right: 0;
}

.category-nav--grid .category-item {
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.category-nav--grid .category-item:active {
  opacity: 0.8;
}

.category-icon-wrap {
  position: relative;
  margin-bottom: var(--space-sm);
}

.category-nav--grid .category-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 500;
  margin-bottom: 0;
  background: var(--color-muted);
  color: #1F2937;
}

.category-badge {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  background: var(--color-destructive);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  line-height: 1.4;
}

.category-nav--grid .category-name {
  font-size: 24rpx;
  color: #374151;
}

/* Hide scrollbar */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}
