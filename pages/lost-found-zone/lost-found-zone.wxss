@import "../wanted-zone/wanted-zone.wxss";

.sub-type-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 2rpx solid var(--color-border);
}

.sub-type-tab {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #64748B;
  position: relative;
}

.sub-type-tab.is-active {
  color: var(--color-primary);
  font-weight: 600;
}

.sub-type-tab.is-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}
