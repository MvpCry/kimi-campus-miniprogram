.admin-posts-page {
  min-height: 100vh;
  padding-bottom: var(--space-3xl);
}

.status-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 2rpx solid var(--color-border);
  padding: 0 var(--space-md);
}

.status-tab {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #64748B;
  position: relative;
}

.status-tab.is-active {
  color: var(--color-primary);
  font-weight: 600;
}

.status-tab.is-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: var(--color-primary);
}

.post-list {
  padding: var(--space-md);
}

.post-item {
  margin-bottom: var(--space-md);
}

.post-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-md);
  margin-top: var(--space-sm);
  padding: 0 var(--space-sm);
}

.action-btn {
  font-size: 24rpx;
  padding: var(--space-sm) var(--space-md);
  border-radius: 8rpx;
}

.action-btn--primary {
  color: var(--color-accent);
  background: rgba(22, 163, 74, 0.1);
}

.action-btn--danger {
  color: var(--color-destructive);
  background: rgba(220, 38, 38, 0.1);
}

.load-more {
  text-align: center;
  padding: var(--space-lg) 0;
  color: #94A3B8;
  font-size: 24rpx;
}
