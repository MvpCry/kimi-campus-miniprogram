<view class="page index-page">
  <!-- 顶部信任标语 -->
  <view class="top-banner" bindtap="onBannerTap">
    <view class="banner-main">
      <text class="banner-title">{{banner.title}}</text>
      <text class="banner-subtitle">{{banner.subtitle}}</text>
    </view>
    <view class="banner-arrow"></view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-section">
    <search-bar
      placeholder="搜索教材、电动车、数码..."
      show-camera="{{true}}"
      show-search-btn="{{true}}"
      bindtap="onSearchTap"
      bindfocus="onSearchFocus"
      bindcamera="onCameraTap"
    />
  </view>

  <!-- 横向分类 Tab -->
  <view class="filter-tabs">
    <scroll-view class="filter-scroll" scroll-x="{{true}}" enhanced show-scrollbar="{{false}}">
      <view
        class="filter-tab {{activeFilterTab === item.id ? 'is-active' : ''}}"
        wx:for="{{filterTabs}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onFilterTabChange"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <!-- 品类网格 -->
  <view class="category-section">
    <category-nav
      categories="{{categories}}"
      theme="grid"
      scrollable="{{true}}"
      bindchange="onCategoryChange"
    />
  </view>

  <!-- 运营位卡片 -->
  <view class="feature-section">
    <view class="feature-list">
      <view
        class="feature-card"
        wx:for="{{featureCards}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onFeatureCardTap"
      >
        <view class="feature-header">
          <view class="feature-icon" style="background: {{item.color}}20; color: {{item.color}};">{{item.icon}}</view>
          <text class="feature-name">{{item.name}}</text>
        </view>
        <text class="feature-desc" style="color: {{item.color}};">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 推荐商品 -->
  <view class="product-section">
    <view class="section-header">
      <text class="section-title">推荐二手商品</text>
      <text class="section-more" bindtap="onSearchTap">查看更多 ></text>
    </view>

    <view class="product-grid" wx:if="{{posts.length > 0}}">
      <product-card
        wx:for="{{posts}}"
        wx:key="id"
        post="{{item}}"
        bindtap="onPostTap"
      />
    </view>

    <empty-state
      wx:else
      icon="search"
      title="还没有商品"
      description="去做第一个发布的人吧"
    />

    <view class="load-more" wx:if="{{posts.length > 0}}">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{hasMore}}">上拉加载更多</text>
      <text wx:else>已经到底啦</text>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="fab-create" bindtap="onCreateTap">
    <view class="fab-icon"></view>
  </view>

  <toast id="toast" />
</view>
