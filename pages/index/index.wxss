.index-page {
  min-height: 100vh;
  padding-bottom: calc(var(--space-3xl) + env(safe-area-inset-bottom));
  background: var(--color-background);
}

/* 顶部信任标语 */
.top-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-md);
  background: #FFFFFF;
}

.banner-main {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-destructive);
}

.banner-subtitle {
  font-size: 24rpx;
  color: #64748B;
}

.banner-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #94A3B8;
  border-right: 3rpx solid #94A3B8;
  transform: rotate(45deg);
}

/* 搜索栏 */
.search-section {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #FFFFFF;
  padding: var(--space-sm) var(--space-md);
}

.search-section search-bar {
  display: block;
}

/* 横向分类 Tab */
.filter-tabs {
  background: #FFFFFF;
  padding: 0 var(--space-md);
  border-bottom: 2rpx solid var(--color-border);
}

.filter-scroll {
  white-space: nowrap;
}

.filter-tab {
  display: inline-block;
  padding: var(--space-md) var(--space-sm);
  margin-right: var(--space-lg);
  font-size: 30rpx;
  color: #64748B;
  position: relative;
  transition: all 150ms ease;
}

.filter-tab:last-child {
  margin-right: 0;
}

.filter-tab.is-active {
  color: #1F2937;
  font-weight: 700;
  font-size: 34rpx;
}

.filter-tab.is-active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* 品类网格 */
.category-section {
  padding: var(--space-md);
}

/* 运营位卡片 */
.feature-section {
  padding: 0 var(--space-md) var(--space-md);
}

.feature-list {
  display: flex;
  gap: var(--space-sm);
}

.feature-card {
  flex: 1;
  min-width: 0;
  background: #FFFFFF;
  border-radius: var(--radius-md);
  padding: var(--space-sm);
  box-shadow: var(--shadow-sm);
  transition: transform 150ms ease;
}

.feature-card:active {
  transform: scale(0.98);
}

.feature-header {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-bottom: var(--space-xs);
}

.feature-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.feature-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1F2937;
}

.feature-desc {
  display: block;
  font-size: 20rpx;
  font-weight: 500;
}

/* 推荐商品 */
.product-section {
  padding: var(--space-md);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.section-more {
  font-size: 24rpx;
  color: #94A3B8;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
  padding-bottom: var(--space-lg);
}

.load-more {
  text-align: center;
  padding: var(--space-lg) 0;
  color: #94A3B8;
  font-size: 24rpx;
}

/* 发布按钮 */
.fab-create {
  position: fixed;
  right: var(--space-lg);
  bottom: calc(var(--space-2xl) + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-md);
  z-index: 100;
  transition: transform 150ms ease;
}

.fab-create:active {
  transform: scale(0.95);
}

.fab-icon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.fab-icon::before,
.fab-icon::after {
  content: '';
  position: absolute;
  background: #FFFFFF;
  border-radius: 2rpx;
}

.fab-icon::before {
  width: 4rpx;
  height: 36rpx;
  left: 18rpx;
  top: 2rpx;
}

.fab-icon::after {
  width: 36rpx;
  height: 4rpx;
  left: 2rpx;
  top: 18rpx;
}
