.admin-users-page {
  min-height: 100vh;
  padding: var(--space-md);
  padding-bottom: var(--space-3xl);
}

.search-bar {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 var(--space-md);
  background: #FFFFFF;
  border-radius: var(--radius-md);
  font-size: 28rpx;
}

.search-btn {
  height: 80rpx;
  padding: 0 var(--space-lg);
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.user-list {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.user-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg);
  border-bottom: 2rpx solid var(--color-border);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.role-tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background: rgba(124, 58, 237, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.user-meta,
.user-status {
  font-size: 24rpx;
  color: #64748B;
  margin-top: var(--space-xs);
}

.mute-btn {
  font-size: 24rpx;
  color: var(--color-destructive);
  padding: var(--space-sm) var(--space-md);
  background: rgba(220, 38, 38, 0.1);
  border-radius: 8rpx;
  flex-shrink: 0;
}

.load-more {
  text-align: center;
  padding: var(--space-lg) 0;
  color: #94A3B8;
  font-size: 24rpx;
}
