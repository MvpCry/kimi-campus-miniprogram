<view class="page admin-reports-page">
  <view class="status-tabs">
    <view
      class="status-tab {{currentStatus === item.id ? 'is-active' : ''}}"
      wx:for="{{STATUS_TABS}}"
      wx:key="id"
      data-status="{{item.id}}"
      bindtap="switchStatus"
    >
      {{item.name}}
    </view>
  </view>

  <view class="report-list" wx:if="{{reports.length > 0}}">
    <view class="report-card" wx:for="{{reports}}" wx:key="id">
      <view class="report-header">
        <text class="report-reason">{{item.reasonText}}</text>
        <text class="report-time">{{item.timeText}}</text>
      </view>

      <view class="report-detail" wx:if="{{item.detail}}">{{item.detail}}</view>

      <view class="report-target" wx:if="{{item.post}}">
        <text class="target-label">被举报帖子：</text>
        <text class="target-title">{{item.post.title}}</text>
      </view>

      <view class="report-reporter" wx:if="{{item.reporter}}">
        举报人：{{item.reporter.nickname}}
      </view>

      <view class="report-actions" wx:if="{{currentStatus === 'pending'}}">
        <view class="action-btn" bindtap="onResolveTap" data-reportid="{{item.id}}">忽略</view>
        <view class="action-btn action-btn--danger" bindtap="onRemoveTap" data-reportid="{{item.id}}">下架帖子</view>
      </view>
    </view>

    <view class="load-more">
      <text wx:if="{{loading}}">加载中...</text>
      <text wx:elif="{{hasMore}}">上拉加载更多</text>
      <text wx:else>已经到底啦</text>
    </view>
  </view>

  <empty-state
    wx:else
    icon="check"
    title="暂无举报"
    description=""
  />
</view>
