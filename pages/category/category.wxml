<view class="page category-page">
  <view class="category-nav-section">
    <category-nav
      categories="{{categories}}"
      active-id="{{activeCategoryId}}"
      theme="pill"
      scrollable
      bindchange="onCategoryChange"
    />
  </view>

  <view class="filter-section">
    <filter-bar
      filters="{{filters}}"
      options="{{filterOptions}}"
      sticky
      bindchange="onFilterChange"
      bindreset="onFilterReset"
    />
  </view>

  <view class="post-section">
    <view class="post-list" wx:if="{{posts.length > 0}}">
      <post-card
        wx:for="{{posts}}"
        wx:key="id"
        post="{{item}}"
        bindtap="onPostTap"
      />

      <view class="load-more">
        <text wx:if="{{loading}}">加载中...</text>
        <text wx:elif="{{hasMore}}">上拉加载更多</text>
        <text wx:else>已经到底啦</text>
      </view>
    </view>

    <empty-state
      wx:else
      icon="filter"
      title="暂无相关帖子"
      description="换个筛选条件试试"
    />
  </view>
</view>
