.profile-page {
  min-height: 100vh;
  padding-bottom: var(--space-3xl);
}

.user-card {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  margin: var(--space-md);
  padding: var(--space-xl);
  background: #FFFFFF;
  border-radius: var(--radius-md);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.verified-tag {
  font-size: 20rpx;
  color: var(--color-accent);
  background: rgba(22, 163, 74, 0.1);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.verified-tag--pending {
  color: #D97706;
  background: rgba(217, 119, 6, 0.1);
}

.user-meta {
  font-size: 26rpx;
  color: #64748B;
}

.menu-group {
  margin: var(--space-md);
  background: #FFFFFF;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.menu-title {
  font-size: 24rpx;
  color: #94A3B8;
  padding: var(--space-sm) var(--space-lg);
  background: var(--color-background);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 2rpx solid var(--color-border);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--color-muted);
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: var(--space-md);
  background: var(--color-primary);
  border-radius: 8rpx;
  flex-shrink: 0;
}

.menu-icon--favorite {
  background: var(--color-destructive);
}

.menu-icon--history {
  background: #64748B;
}

.menu-icon--verify {
  background: var(--color-accent);
}

.menu-icon--admin {
  background: #1F2937;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #1F2937;
}

.menu-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #94A3B8;
  border-right: 4rpx solid #94A3B8;
  transform: rotate(45deg);
}
